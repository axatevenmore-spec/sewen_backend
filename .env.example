# Django
# Required whenever DJANGO_DEBUG is off (the server refuses to start without
# it). Generate a fresh one per environment, never commit it:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# development | production. Production never falls back to a built-in key.
DJANGO_ENV=development
# Defaults to False. Only ever True on a developer machine.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production behind TLS (see `python manage.py check --deploy`):
# DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.example.com
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_PROXY_SSL_HEADER=True

# PostgreSQL (db.md 1.1 - PostgreSQL 15+)
DB_NAME=evenmore_erp
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432

# JWT lifetimes (api.md 1.2)
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14

# CORS (api-integration.md blocker 6) - the Vite dev origin
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# The web app's address, used in emailed links (account invites)
FRONTEND_URL=http://localhost:5173

# Files (api.md 1.12). Backend "local" serves presigned-style URLs from this server.
FILE_STORAGE_BACKEND=local
FILE_MAX_BYTES=26214400
PMS_PROOF_MAX_BYTES=52428800

# Exchange rates (api.md 12.4) - fetched server-side, cached a day
EXCHANGE_RATE_URL=https://open.er-api.com/v6/latest/USD

# Socket.IO (apps/core/realtime.py). Empty = single process. Behind several
# workers set a Redis URL (and pip install redis) so emits reach every socket.
SOCKETIO_MESSAGE_QUEUE=

# Email configuration (for OTP and system notifications)
# In dev (DEBUG=True), defaults to console.EmailBackend if not specified.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
# Rate Limiting & Proxy Configuration
LOGIN_RATE_LIMIT=5/minute
LOGIN_FAILED_RATE_LIMIT=10/10minute
AUTHENTICATED_RATE_LIMIT=120/minute
ANONYMOUS_RATE_LIMIT=30/minute
PASSWORD_RESET_RATE_LIMIT=3/15minute
OTP_VERIFY_RATE_LIMIT=5/10minute
TOKEN_REFRESH_RATE_LIMIT=10/10minute
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=3
NUM_PROXIES=0
TRUSTED_PROXIES=

# Cache / Redis configuration
# Behind several workers, set a Redis URL (e.g. redis://127.0.0.1:6379/1)
REDIS_URL=

# Keep 0 under ASGI (daphne / runserver): a persistent connection per request
# thread exhausts Postgres. Only raise it for a WSGI deployment.
DB_CONN_MAX_AGE=0
