# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (db.md 1.1 - PostgreSQL 15+)
DB_NAME=evenmore_erp
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432

# JWT lifetimes (api.md 1.2)
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14

# CORS (api-integration.md blocker 6) - the Vite dev origin
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Files (api.md 1.12). Backend "local" serves presigned-style URLs from this server.
FILE_STORAGE_BACKEND=local
FILE_MAX_BYTES=26214400
PMS_PROOF_MAX_BYTES=52428800

# Exchange rates (api.md 12.4) - fetched server-side, cached a day
EXCHANGE_RATE_URL=https://open.er-api.com/v6/latest/USD

# Socket.IO (apps/core/realtime.py). Empty = single process. Behind several
# workers set a Redis URL (and pip install redis) so emits reach every socket.
SOCKETIO_MESSAGE_QUEUE=
